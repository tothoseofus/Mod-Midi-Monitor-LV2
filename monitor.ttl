@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rsz: <http://lv2plug.in/ns/ext/resize-port#> .

<https://github.com/tothoseofus/Mod-Midi-Monitor-LV2>
    a lv2:Plugin , lv2:UtilityPlugin , mod:MIDIPlugin ;
    doap:name "piStomp MIDI Monitor" ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ken Spanks" ] ;
    doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
    doap:revision "0.1.0" ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    patch:readable <https://github.com/tothoseofus/Mod-Midi-Monitor-LV2#lastMidi> ;
    lv2:requiredFeature urid:map ;
    lv2:port
    [ a lv2:InputPort, atom:AtomPort ; lv2:index 0 ;
      lv2:name "MIDI In" ; lv2:symbol "midi_in" ;
      atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 1 ; lv2:name "Message Count" ;
      lv2:symbol "count" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 16777215.0 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 2 ; lv2:name "Status Byte" ;
      lv2:symbol "status" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 255.0 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 3 ; lv2:name "Data Byte 1" ;
      lv2:symbol "data1" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 127.0 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 4 ; lv2:name "Data Byte 2" ;
      lv2:symbol "data2" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 127.0 ],
    [ a lv2:OutputPort, atom:AtomPort ; lv2:index 5 ;
      lv2:name "Monitor Notifications" ; lv2:symbol "notify" ;
      atom:bufferType atom:Sequence ; atom:supports patch:Message ;
      lv2:designation lv2:control ; rsz:minimumSize 4096 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 6 ;
      lv2:name "Batches Emitted" ; lv2:symbol "batch_count" ;
      lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 16777215.0 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 7 ;
      lv2:name "Queue Drops" ; lv2:symbol "queue_drops" ;
      lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 16777215.0 ],
    [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 8 ;
      lv2:name "Unsupported Events" ; lv2:symbol "unsupported" ;
      lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 16777215.0 ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ;
      lv2:name "History Events" ; lv2:symbol "history_events" ;
      lv2:default 10000.0 ; lv2:minimum 100.0 ; lv2:maximum 50000.0 ;
      lv2:portProperty lv2:integer ],
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ;
      lv2:name "History Memory (MiB)" ; lv2:symbol "history_memory_mib" ;
      lv2:default 16.0 ; lv2:minimum 4.0 ; lv2:maximum 64.0 ;
      lv2:portProperty lv2:integer ] ;
    modgui:gui <https://github.com/tothoseofus/Mod-Midi-Monitor-LV2/gui> .

<https://github.com/tothoseofus/Mod-Midi-Monitor-LV2/gui>
    a modgui:GUI ;
    modgui:resourcesDirectory <modgui> ;
    modgui:iconTemplate <modgui/icon.html> ;
    modgui:stylesheet <modgui/stylesheet.css> ;
    modgui:javascript <modgui/javascript.js> ;
    modgui:screenshot <modgui/screenshot.png> ;
    modgui:thumbnail <modgui/thumbnail.png> ;
    modgui:monitoredOutputs [ lv2:symbol "count" ],
        [ lv2:symbol "status" ], [ lv2:symbol "data1" ],
        [ lv2:symbol "data2" ], [ lv2:symbol "batch_count" ],
        [ lv2:symbol "queue_drops" ], [ lv2:symbol "unsupported" ] .

<https://github.com/tothoseofus/Mod-Midi-Monitor-LV2#lastMidi>
    a lv2:Parameter ;
    rdfs:label "Latest MIDI Event Batch" ;
    rdfs:range atom:String .
